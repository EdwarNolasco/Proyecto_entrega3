@{
    ViewData["Title"] = "Asignatura";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h2>Asignatura</h2>

@(Html.DevExtreme().DataGrid<Proyecto_entrega3.Models.Asignatura>()
    .ShowBorders(true)
    .DataSource(d => d.WebApi().Controller("Asignatura")
    .UpdateAction(true)
    .InsertAction(true)
    .DeleteAction(true)
    .Key("IdAsignatura"))
    .Columns(columns =>
    {
        columns.AddFor(m => m.IdAsignatura);
        columns.AddFor(m => m.Nombreasig);
        columns.AddFor(m => m.Estadoasig);
        columns.AddFor(m => m.IdCarrera)
        .Lookup(lookUp => lookUp
                    .DataSource(
                        d=> d.WebApi()
                        .Controller("Carrera")
                        .LoadAction("Get")
                        .Key("IdCarrera")
                    )
                    .ValueExpr("IdCarrera")
                    .DisplayExpr("Nombrecarrera")
            );
        columns.AddFor(m => m.IdEstudiante)
        .Lookup(lookUp => lookUp
            .DataSource(
                d => d.WebApi()
                .Controller("Estudiante")
                .LoadAction("Get")
                .Key("IdEstudiante")
            )
            .ValueExpr("IdEstudiante")
            .DisplayExpr("Primernombre")
        );
    })
    .Editing(editing =>
    {
        editing.Mode(GridEditMode.Popup);
        editing.AllowUpdating(true);
        editing.AllowAdding(true);
        editing.AllowDeleting(true);
    })
    .Paging(p => p.PageSize(100))
    .FilterRow(f => f.Visible(true))
    .HeaderFilter(f => f.Visible(true))
    .GroupPanel(p => p.Visible(true))
    .Grouping(g => g.AutoExpandAll(false))
    .RemoteOperations(true)
)
