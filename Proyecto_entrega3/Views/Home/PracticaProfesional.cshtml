@{
    ViewData["Title"] = "PracticaProfesional";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h2>PracticaProfesional</h2>

@(Html.DevExtreme().DataGrid<Proyecto_entrega3.Models.PracticaProfesional>()
    .ShowBorders(true)
    .DataSource(d => d.WebApi().Controller("PracticaProfesional")
    .UpdateAction(true)
    .InsertAction(true)
    .DeleteAction(true)
    .Key("IdPractica"))
    .Columns(columns =>
    {
        columns.AddFor(m => m.IdPractica);
        columns.AddFor(m => m.FechaInicio);
        columns.AddFor(m => m.FechaFin);
        columns.AddFor(m => m.Titulo);
        columns.AddFor(m => m.Descripcionpractica);
        columns.AddFor(m => m.IdEstudiante)
        .Lookup(lookUp => lookUp
            .DataSource(
                d => d.WebApi()
                .Controller("Estudiante")
                .LoadAction("Get")
                .Key("IdEstudiante")
            )
            .ValueExpr("IdEstudiante")
            .DisplayExpr("Primernombre")
    );
        columns.AddFor(m => m.IdSupervisor)
        .Lookup(lookUp => lookUp
            .DataSource(
                d => d.WebApi()
                .Controller("Supervisor")
                .LoadAction("Get")
                .Key("IdSupervisor")
            )
            .ValueExpr("IdSupervisor")
            .DisplayExpr("Primernombre")
    );
        columns.AddFor(m => m.IdArea)
        .Lookup(lookUp => lookUp
            .DataSource(
                d => d.WebApi()
                .Controller("Area")
                .LoadAction("Get")
                .Key("IdArea")
            )
            .ValueExpr("IdArea")
            .DisplayExpr("Nombrearea")
    );
    })
    .Editing(editing =>
    {
        editing.Mode(GridEditMode.Popup);
        editing.AllowUpdating(true);
        editing.AllowAdding(true);
        editing.AllowDeleting(true);
    })
    .Paging(p => p.PageSize(100))
    .FilterRow(f => f.Visible(true))
    .HeaderFilter(f => f.Visible(true))
    .GroupPanel(p => p.Visible(true))
    .Grouping(g => g.AutoExpandAll(false))
    .RemoteOperations(true)
)