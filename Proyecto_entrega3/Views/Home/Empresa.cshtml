@{
    ViewData["Title"] = "Empresa";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h2>Empresa</h2>

@(Html.DevExtreme().DataGrid<Proyecto_entrega3.Models.Empresa>()
    .ShowBorders(true)
    .DataSource(d => d.WebApi().Controller("Empresa")
    .UpdateAction(true)
    .InsertAction(true)
    .DeleteAction(true)
    .Key("IdEmpresa"))
    .Columns(columns =>
    {
        columns.AddFor(m => m.IdEmpresa);
        columns.AddFor(m => m.nombreempresa);
        columns.AddFor(m => m.telefonoempresa);
        columns.AddFor(m => m.correoempresa);
        columns.AddFor(m => m.direccionempresa);
    })
    .Editing(editing =>
    {
        editing.Mode(GridEditMode.Popup);
        editing.AllowUpdating(true);
        editing.AllowAdding(true);
        editing.AllowDeleting(true);
    })
    .Paging(p => p.PageSize(100))
    .FilterRow(f => f.Visible(true))
    .HeaderFilter(f => f.Visible(true))
    .GroupPanel(p => p.Visible(true))
    .Grouping(g => g.AutoExpandAll(false))
    .RemoteOperations(true)
)