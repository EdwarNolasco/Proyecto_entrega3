@{
    ViewData["Title"] = "SolicitudPractica";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h2>SolicitudPractica</h2>

@(Html.DevExtreme().DataGrid<Proyecto_entrega3.Models.SolicitudPractica>()
    .ShowBorders(true)
    .DataSource(d => d.WebApi().Controller("SolicitudPractica")
    .UpdateAction(true)
    .InsertAction(true)
    .DeleteAction(true)
    .Key("IdSolicitud"))
    .Columns(columns =>
    {
        columns.AddFor(m => m.IdSolicitud);
        columns.AddFor(m => m.FechaSolicitud);
        columns.AddFor(m => m.EstadoSolicitud);
        columns.AddFor(m => m.FechaInicio);
        columns.AddFor(m => m.FechaFin);
        columns.AddFor(m => m.ObservacionesSolicitud);
        columns.AddFor(m => m.IdEstudiante)
        .Lookup(lookUp => lookUp
            .DataSource(
                d => d.WebApi()
                .Controller("Estudiante")
                .LoadAction("Get")
                .Key("IdEstudiante")
            )
            .ValueExpr("IdEstudiante")
            .DisplayExpr("Primernombre")
    );
        columns.AddFor(m => m.IdEmpresa)
        .Lookup(lookUp => lookUp
            .DataSource(
                d => d.WebApi()
                .Controller("Empresa")
                .LoadAction("Get")
                .Key("IdEmpresa")
            )
            .ValueExpr("IdEmpresa")
            .DisplayExpr("nombreempresa")
    );
    })
    .Editing(editing =>
    {
        editing.Mode(GridEditMode.Popup);
        editing.AllowUpdating(true);
        editing.AllowAdding(true);
        editing.AllowDeleting(true);
    })
    .Paging(p => p.PageSize(100))
    .FilterRow(f => f.Visible(true))
    .HeaderFilter(f => f.Visible(true))
    .GroupPanel(p => p.Visible(true))
    .Grouping(g => g.AutoExpandAll(false))
    .RemoteOperations(true)
)
